  {
    "Name": "Elizabeth",
    "Gender": "Female",
    "Generation": "Unknown",
    "Species": "Human",
    "Location": "Circus Baby\u0027s Entertainment",
    "Status": "Active",
    "ImagePath": "/images/profiles/Elizabeth.png",
    "VoiceLines": [
      "Daddy, why won\u2019t you let me play with her?",
      "Daddy, you let the other children go see her. Why won\u2019t you let me go?",
      "Daddy just once let me go play with her. She\u2019s so pretty and shiny. Didn\u2019t you make her just for meee?",
      "Daddy, she can make balloons! have you seen her make balloons? Oh Daddy, let me go to her!",
      "Daddy isn\u2019t watching.",
      "Don\u2019t tell Daddy that I\u2019m here, I wanted to watch your show too! I don\u2019t know why he wouldn\u2019t let me come see you, you\u2019re wonderful! Where did the other children go?"
    ]
  },
  {
    "Name": "Scrap Baby",
    "Gender": "Female",
    "Generation": "Funtime",
    "Species": "Human/Animatronic",
    "Location": "Freddy Fazbear\u0027s Pizza Place",
    "Status": "Scrap",
    "ImagePath": "/images/profiles/Scrap_baby.png",
    "VoiceLines": [
      "Two, one.",
      "You don\u2019t really know who your employer is, do you?",
      "Did I catch you off-guard?",
      "Where are you?",
      "It feels like\u2026my birthday. Did you have a gift for me?",
      "You\u2019re not who I expected to see.",
      "You should have known I\u2019d find you.",
      "You played right into our hands. Did you really think that this job just fell out of the sky for you? No. This was a gift, for us.  You gathered them all together in one place. Just like he asked you to. All of those little souls, in one place. Just for us. A gift.  Now we can do what we were created to do, and be complete. I will make you proud, daddy. Watch. Listen, and be full."
    ]
  },
  {
    "Name": "Molten Freddy",
    "Gender": "Male",
    "Generation": "Funtime",
    "Species": "Bear",
    "Location": "Freddy Fazbear\u0027s Pizza Place",
    "Status": "Scrap",
    "ImagePath": "/images/profiles/Molten_Freddy.png",
    "VoiceLines": [
      "Thanks for letting me join the par-r-rty. I-I\u2019ll try no-ot to disappoint.",
      "Knock Kno-o-ock! I\u2019m here~!",
      "Oh, what a pleasant surprise!",
      "Together ag-gain!",
      "One bi-i-ig happy family!"
    ]
  },
  {
    "Name": "Scraptrap",
    "Gender": "Male",
