@{
    ViewData["Title"] = ViewBag.Username + " - Profile";
    var favCharacters = ViewBag.FavCharacters as List<FNaFle.Models.Character>;
    string profilePic = string.IsNullOrEmpty(ViewBag.ProfilePicturePath) ? "/images/default-profile.png" : ViewBag.ProfilePicturePath;
}

<div class="background-blur"></div>

<div class="top-bar">
    <a asp-controller="Home" asp-action="Leaderboard" class="auth-box">← Leaderboard</a>
</div>

<div class="page-container">
    <div class="profile-card glass-panel">

        <div class="profile-banner"></div>

        <div class="profile-header">
            <div class="avatar-wrapper-public">
                <img src="@profilePic" onerror="this.src='/images/default-profile.png'" />
            </div>

            <div class="profile-title-block">
                <h1 class="public-username">@ViewBag.Username</h1>
                <span class="user-badge">Registered Player</span>
            </div>
        </div>

        <div class="profile-body">

            <div class="section-block">
                <h4 class="section-title">Statistics</h4>

                <div class="stats-grid">
                    <div class="stat-box">
                        <span class="stat-label">Highest Streak</span>
                        <span class="stat-value">@ViewBag.HighestStreak</span>
                    </div>

                    <div class="stat-box">
                        <span class="stat-label">Current Streak</span>
                        <span class="stat-value">@ViewBag.CurrentStreak</span>
                    </div>
                </div>
            </div>

            <div class="section-block border-top">
                <h4 class="section-title">Top Characters</h4>

                <div class="chars-grid">
                    @if (favCharacters != null && favCharacters.Count > 0)
                    {
                        foreach (var ch in favCharacters)
                        {
                            <div class="char-pill">@ch.Name</div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">No characters selected.</div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<style>

    /* LAYOUT */
    .page-container {
        padding-top: 120px;
        display: flex;
        justify-content: center;
    }

    /* CARD */
    .profile-card {
        width: 700px;
        max-width: 95%;
        padding: 0; /* override glass-panel for flush banner */
        overflow: hidden;
    }

    /* BANNER */
    .profile-banner {
        height: 140px;
        background: linear-gradient(135deg, #1a1a1a, #000);
        position: relative;
    }

        .profile-banner::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(255,0,0,0.15), transparent 70%);
        }

    /* HEADER */
    .profile-header {
        margin-top: -70px;
        padding: 0 25px;
    }

    /* 🔥 FIXED AVATAR */
    .avatar-wrapper-public {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: radial-gradient(circle, #111 40%, #000);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 3px solid rgba(255,0,0,0.4);
        box-shadow: 0 0 25px rgba(255,0,0,0.4), inset 0 0 10px rgba(0,0,0,0.7);
        transition: all 0.3s;
        /* Fix for Safari/Chrome border-radius clipping glitch during transforms */
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
    }

        .avatar-wrapper-public:hover {
            -webkit-transform: scale(1.05) translateZ(0);
            transform: scale(1.05) translateZ(0);
            box-shadow: 0 0 35px rgba(255,0,0,0.7), inset 0 0 15px rgba(0,0,0,0.9);
        }

        .avatar-wrapper-public img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* 🔥 THIS FIXES CUTTING */
            box-sizing: border-box; /* Fixes padding overflow glitch */

            padding: 8px; /* gives breathing space */

            filter: drop-shadow(0 0 8px rgba(0,0,0,0.8));
        }

    /* USERNAME */
    .profile-title-block {
        margin-top: 15px;
    }

    .public-username {
        font-size: 28px;
        color: white;
        margin: 0;
    }

    .user-badge {
        display: inline-block;
        margin-top: 8px;
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 5px 12px;
        border-radius: 8px;
        color: #aaa;
        font-size: 12px;
    }

    /* BODY */
    .profile-body {
        padding: 25px;
    }

    /* SECTION */
    .section-block {
        margin-top: 25px;
    }

        .section-block.border-top {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 20px;
        }

    /* TITLES */
    .section-title {
        color: white;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* STATS */
    .stats-grid {
        display: flex;
        gap: 15px;
        margin-top: 15px;
    }

    .stat-box {
        flex: 1;
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px;
        transition: all 0.25s;
    }

        .stat-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(255,0,0,0.2);
        }

    /* STAT TEXT */
    .stat-label {
        font-size: 12px;
        color: #888;
    }

    .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: white;
    }

    /* CHARACTERS */
    .chars-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 15px;
    }

    .char-pill {
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 10px 18px;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        transition: all 0.2s;
    }

        .char-pill:hover {
            transform: translateY(-2px);
            border-color: rgba(255,0,0,0.5);
            box-shadow: 0 0 15px rgba(255,0,0,0.3);
        }

    /* EMPTY */
    .empty-state {
        color: #666;
        font-style: italic;
    }
</style>