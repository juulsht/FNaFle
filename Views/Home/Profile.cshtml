@model FNaFle.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Profile Settings";
}

<div class="background-blur"></div>

<div class="top-bar">
    <a asp-controller="Home" asp-action="Index" class="auth-box">← Home</a>
</div>

<div class="page-container">
    <div class="settings-card glass-panel">

        <div class="settings-header">
            <h1 class="settings-title">Profile Settings</h1>
            <p class="settings-subtitle">Customize your identity</p>
        </div>

        <form asp-action="Profile" method="post" enctype="multipart/form-data">

            <div class="settings-body">

                
                <div class="avatar-section">
                    <div class="avatar-wrapper">
                        @if (!string.IsNullOrEmpty(Model.CurrentProfilePicturePath))
                        {
                            <img id="pic-preview" src="@Model.CurrentProfilePicturePath" />
                        }
                        else
                        {
                            <img id="pic-preview" src="/images/animatronics/Freddy_Fazbear.webp" style="opacity:0.3; filter:grayscale(100%);" />
                        }
                    </div>

                    <label for="ProfilePicture" class="btn-glass-secondary">
                        Change Avatar
                    </label>

                    <input asp-for="ProfilePicture" type="file" id="ProfilePicture"
                           accept="image/*" onchange="previewImage(event)" style="display:none;" />
                </div>

                <div class="form-section">

                    <div class="form-group">
                        <label>Current Username</label>
                        <div class="form-static">@Model.CurrentUsername</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="NewUsername">New Username</label>
                        <input asp-for="NewUsername" class="auth-input" placeholder="Leave blank to keep current" />
                        <span asp-validation-for="NewUsername" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FavChar1Id">Favorite Character #1</label>
                        <select asp-for="FavChar1Id" class="auth-input" asp-items="@(new SelectList(Model.AvailableCharacters, "Id", "Name"))">
                            <option value="">-- Select Character --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="FavChar2Id">Favorite Character #2</label>
                        <select asp-for="FavChar2Id" class="auth-input" asp-items="@(new SelectList(Model.AvailableCharacters, "Id", "Name"))">
                            <option value="">-- Select Character --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="FavChar3Id">Favorite Character #3</label>
                        <select asp-for="FavChar3Id" class="auth-input" asp-items="@(new SelectList(Model.AvailableCharacters, "Id", "Name"))">
                            <option value="">-- Select Character --</option>
                        </select>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-glass-primary">Save Changes</button>
                    </div>

                </div>

            </div>

        </form>

    </div>
</div>

<style>
    .page-container {
        padding-top: 120px;
        display: flex;
        justify-content: center;
    }

    .settings-card {
        width: 1000px;
        max-width: 95%;
    }

    .settings-header {
        margin-bottom: 25px;
    }

    .settings-title {
        font-size: 28px;
        color: #fff;
    }

    .settings-subtitle {
        color: #aaa;
        font-size: 14px;
    }

    .settings-body {
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    .avatar-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .avatar-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid rgba(255,0,0,0.3);
        box-shadow: 0 0 20px rgba(255,0,0,0.3), inset 0 0 10px rgba(0,0,0,0.7);
        transition: all 0.3s;
    }

        .avatar-wrapper:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(255,0,0,0.6), inset 0 0 15px rgba(0,0,0,0.9);
        }

        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .form-section {
        flex: 1;
    }

    .form-group {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    label {
        font-size: 12px;
        text-transform: uppercase;
        color: #888;
        letter-spacing: 1px;
    }

    .form-static {
        background: rgba(0,0,0,0.6);
        padding: 12px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        font-weight: bold;
    }

    .form-actions {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }
</style>

<script>
    function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function() {
            var output = document.getElementById('pic-preview');
            output.src = reader.result;
            output.style.opacity = "1";
            output.style.filter = "none";
        }
        if(event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }
</script>