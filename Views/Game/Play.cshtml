@model FNaFle.Models.Character
@{
    Layout = "_Layout";
    ViewData["Title"] = "Play FNaFle";

    var target = ViewBag.Character as FNaFle.Models.Character;
    var history = ViewBag.History as List<FNaFle.Models.Character>;
    var guessedCorrectlyToday = ViewBag.GuessedCorrectlyToday as bool? ?? false;
}

<div class="background-blur"></div>

<div class="top-bar">
    <a asp-controller="Home" asp-action="Index" class="auth-box">Home</a>
</div>

<div class="game-container">

    <div class="logo-container">
        <h1 class="game-title">FNaFle</h1>
        <p class="subtitle">Can you beat the night?</p>
    </div>

    @if (!guessedCorrectlyToday)
    {
        <form asp-action="Play" method="post" class="guess-form">
            <input type="text" name="guess" placeholder="Enter character..."
                   class="mode-input" required />

            <button type="submit" class="mode-button classic">
                <span>Guess</span>
            </button>
        </form>
    }
    else
    {
        <p class="success-msg">
            🎉 You already guessed today's character — come back tomorrow!
        </p>
    }

    @if (ViewBag.Error != null)
    {
        <p class="error-msg">@ViewBag.Error</p>
    }

    @if (ViewBag.Message != null)
    {
        <p class="result-msg @(ViewBag.Message.ToString().Contains("Correct") ? "correct" : "wrong")">
            @ViewBag.Message
        </p>
    }

    <div class="history-list">
        @if (history != null)
        {
            @foreach (var g in history)
            {
                <div class="guess-row">

                    <div class="reveal-box glass-panel image-box" style="padding:0; overflow:hidden;">
                        <img src="@g.ImagePath" onerror="this.src='/images/placeholder.png'" />
                    </div>

                    <div class="reveal-box glass-panel @(g.Name == target.Name ? "box-correct" : "box-wrong")">
                        <div class="attr-key">Name</div>
                        <div class="attr-value">@g.Name</div>
                    </div>

                    <div class="reveal-box glass-panel @(g.Gender == target.Gender ? "box-correct" : "box-wrong")">
                        <div class="attr-key">Gender</div>
                        <div class="attr-value">@g.Gender</div>
                    </div>

                    <div class="reveal-box glass-panel @(g.Generation == target.Generation ? "box-correct" : "box-wrong")">
                        <div class="attr-key">Gen</div>
                        <div class="attr-value">@g.Generation</div>
                    </div>

                    <div class="reveal-box glass-panel @(g.Species == target.Species ? "box-correct" : "box-wrong")">
                        <div class="attr-key">Species</div>
                        <div class="attr-value">@g.Species</div>
                    </div>

                    <div class="reveal-box glass-panel @(g.Location == target.Location ? "box-correct" : "box-wrong")">
                        <div class="attr-key">Location</div>
                        <div class="attr-value small">@g.Location</div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>

    /* MAIN LAYOUT */
    .game-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 120px;
        min-height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
    }

    /* FORM */
    .guess-form {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    /* MESSAGES */
    .success-msg {
        color: #4cff9a;
        font-weight: bold;
        font-size: 20px;
        text-shadow: 0 0 12px rgba(0,255,150,0.6);
    }

    .error-msg {
        color: #ff4d4d;
        font-weight: bold;
        text-shadow: 0 0 12px rgba(255,0,0,0.6);
    }

    .result-msg {
        margin-top: 15px;
        font-size: 20px;
        font-weight: bold;
    }

        .result-msg.correct {
            color: #4cff9a;
            text-shadow: 0 0 12px rgba(0,255,150,0.6);
        }

        .result-msg.wrong {
            color: #ff4d4d;
            text-shadow: 0 0 12px rgba(255,0,0,0.6);
        }

    /* HISTORY */
    .history-list {
        margin-top: 30px;
        width: 100%;
        max-width: 950px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* ROW */
    .guess-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        animation: slideIn 0.6s ease-out;
    }

    /* BOXES */
    .reveal-box {
        width: 120px;
        height: 120px;
        padding: 0 !important;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        opacity: 0;
        transform: perspective(600px) rotateY(90deg) scale(0.95);
        animation: flipReveal 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        transition: all 0.3s ease;
    }

        /* HOVER COOL EFFECT */
        .reveal-box:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(255,0,0,0.25), inset 0 0 15px rgba(0,0,0,0.9);
        }

    /* IMAGE */
    .image-box {
        padding: 0;
        overflow: hidden;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* CORRECT */
    .box-correct {
        background: linear-gradient(135deg, #198754 0%, #0d4a2e 100%) !important;
        border-color: #2fb370 !important;
        box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.6), 0 0 10px rgba(25, 135, 84, 0.5) !important;
    }

    /* WRONG */
    .box-wrong {
        background: linear-gradient(135deg, #bb2d3b 0%, #5a141b 100%) !important;
        border-color: #ff4d4d !important;
        box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.6), 0 0 10px rgba(187, 45, 59, 0.5) !important;
    }

    /* TEXT */
    .attr-key {
        font-size: 11px;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .attr-value {
        font-weight: bold;
        font-size: 13px;
        padding: 0 6px;
        text-align: center;
        word-break: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .attr-value.small {
            font-size: 11px;
        }

    /* ANIMATIONS */
    @@keyframes flipReveal {
        0%

    {
        opacity: 0;
        transform: perspective(700px) rotateY(90deg) scale(0.9);
    }

    50% {
        opacity: 1;
    }

    100% {
        opacity: 1;
        transform: perspective(700px) rotateY(0deg) scale(1);
    }

    }

    /* SLOW STAGGER */
    .guess-row .reveal-box:nth-child(1) {
        animation-delay: 0.2s;
    }

    .guess-row .reveal-box:nth-child(2) {
        animation-delay: 0.4s;
    }

    .guess-row .reveal-box:nth-child(3) {
        animation-delay: 0.6s;
    }

    .guess-row .reveal-box:nth-child(4) {
        animation-delay: 0.8s;
    }

    .guess-row .reveal-box:nth-child(5) {
        animation-delay: 1s;
    }

    .guess-row .reveal-box:nth-child(6) {
        animation-delay: 1.2s;
    }

    /* ROW ENTRY */
    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>