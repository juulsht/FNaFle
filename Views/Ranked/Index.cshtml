@model FNaFle.Models.Character
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ranked Mode";

    var target = ViewBag.Character as FNaFle.Models.Character;
    var history = ViewBag.History as List<FNaFle.Models.Character> ?? new List<FNaFle.Models.Character>();
    var guessedCorrectlyToday = ViewBag.GuessedCorrectlyToday as bool? ?? false;

    int maxTries = 3;
    int historyCount = history.Count;
    int livesLeft = maxTries - historyCount;
}

<div class="background-blur"></div>

<div class="top-bar">
    <a asp-controller="Home" asp-action="Index" class="auth-box">Home</a>
</div>

<div class="game-container">

    <div class="logo-container">
        <h1 class="game-title">FNaFle</h1>
        <p class="subtitle">Ranked • @livesLeft Tries Remaining</p>
    </div>

    @if (!guessedCorrectlyToday && livesLeft > 0)
    {
        <form asp-controller="Ranked" asp-action="Play" method="post" class="guess-form">
            <input type="text" name="guess" placeholder="Enter character..."
                   class="mode-input" required />

            <button type="submit" class="mode-button classic">
                <span>Guess</span>
            </button>
        </form>
    }
    else if (guessedCorrectlyToday)
    {
        <div class="text-center mb-4">
            <p class="success-msg">
                You already guessed today's character — return tomorrow!
            </p>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <p class="error-msg">
                No tries left — come back tomorrow.
            </p>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="text-center mb-4"><p class="error-msg">@ViewBag.Error</p></div>
    }

    @if (ViewBag.Message != null)
    {
        <div class="text-center mb-4">
            <p class="@(ViewBag.Message.ToString().Contains("Correct") ? "success-msg" : "error-msg")">
                @ViewBag.Message
            </p>
        </div>
    }

    <div class="history-list">
        @for (int i = 0; i < historyCount; i++)
        {
            var g = history[i];
            int guessAttemptNumber = historyCount - i;

            bool hideLocation = (guessAttemptNumber == 1);
            bool hideSpecies = (guessAttemptNumber == 2);
            bool hideGen = (guessAttemptNumber == 3);

            <div class="guess-row">

                <div class="reveal-box image-box">
                    <img src="@g.ImagePath" onerror="this.src='/images/placeholder.png'" />
                </div>

                <div class="reveal-box @(g.Name == target.Name ? "box-correct" : "box-wrong")">
                    <div class="attr-key">Name</div>
                    <div class="attr-value">@g.Name</div>
                </div>

                <div class="reveal-box @(g.Gender == target.Gender ? "box-correct" : "box-wrong")">
                    <div class="attr-key">Gender</div>
                    <div class="attr-value">@g.Gender</div>
                </div>

                <div class="reveal-box @(hideGen ? "box-hidden" : (g.Generation == target.Generation ? "box-correct" : "box-wrong"))">
                    <div class="attr-key">Gen</div>
                    <div class="attr-value">@(hideGen ? "???" : g.Generation)</div>
                </div>

                <div class="reveal-box @(hideSpecies ? "box-hidden" : (g.Species == target.Species ? "box-correct" : "box-wrong"))">
                    <div class="attr-key">Species</div>
                    <div class="attr-value">@(hideSpecies ? "???" : g.Species)</div>
                </div>

                <div class="reveal-box @(hideLocation ? "box-hidden" : (g.Location == target.Location ? "box-correct" : "box-wrong"))">
                    <div class="attr-key">Location</div>
                    <div class="attr-value small">@(hideLocation ? "???" : g.Location)</div>
                </div>

            </div>
        }
    </div>
</div>

<style>

    /* SAME AS CLASSIC */
    .game-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 120px;
        min-height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
    }

    /* FORM */
    .guess-form {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }



    /* HISTORY */
    .history-list {
        margin-top: 30px;
        width: 100%;
        max-width: 950px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* ROW */
    .guess-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        animation: slideIn 0.6s ease-out;
    }

    /* BOXES (IDENTICAL TO CLASSIC) */
    .reveal-box {
        width: 120px;
        height: 120px;
        background: rgba(30,30,30,0.85);
        backdrop-filter: blur(5px);
        border: 2px solid #444;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        opacity: 0;
        transform: perspective(600px) rotateY(90deg) scale(0.95);
        animation: flipReveal 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        transition: all 0.3s ease;
    }

    /* IMAGE */
    .image-box {
        padding: 0;
        overflow: hidden;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* CORRECT */
    .box-correct {
        background: linear-gradient(135deg, #198754 0%, #0d4a2e 100%) !important;
        border-color: #2fb370 !important;
        box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.6), 0 0 10px rgba(25, 135, 84, 0.5) !important;
    }

    /* WRONG */
    .box-wrong {
        background: linear-gradient(135deg, #bb2d3b 0%, #5a141b 100%) !important;
        border-color: #ff4d4d !important;
        box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.6), 0 0 10px rgba(187, 45, 59, 0.5) !important;
    }

    /* 🔥 HIDDEN (MATCHES STYLE, JUST DARKER) */
    .box-hidden {
        background: rgba(5,5,5,0.9);
        border: 1px dashed rgba(255,255,255,0.2);
        color: #aaa;
    }

    /* TEXT FIX */
    .attr-key {
        font-size: 11px;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .attr-value {
        font-weight: bold;
        font-size: 13px;
        padding: 0 6px;
        text-align: center;
        word-break: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .attr-value.small {
            font-size: 11px;
        }

    /* ANIMATIONS */
    @@keyframes flipReveal {
        0%

    {
        opacity: 0;
        transform: perspective(700px) rotateY(90deg) scale(0.9);
    }

    50% {
        opacity: 1;
    }

    100% {
        opacity: 1;
        transform: perspective(700px) rotateY(0deg) scale(1);
    }

    }

    /* STAGGER */
    .guess-row .reveal-box:nth-child(1) {
        animation-delay: 0.2s;
    }

    .guess-row .reveal-box:nth-child(2) {
        animation-delay: 0.4s;
    }

    .guess-row .reveal-box:nth-child(3) {
        animation-delay: 0.6s;
    }

    .guess-row .reveal-box:nth-child(4) {
        animation-delay: 0.8s;
    }

    .guess-row .reveal-box:nth-child(5) {
        animation-delay: 1s;
    }

    .guess-row .reveal-box:nth-child(6) {
        animation-delay: 1.2s;
    }

    /* ROW ENTRY */
    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>