                { name: "CAM 04", top: "41%", left: "38%", w: "12%", h: "11%" },
                { name: "CAM 11", top: "32%", left: "87%", w: "12%", h: "11%" },
                { name: "CAM 01", top: "62%", left: "6.5%", w: "12%", h: "11%" },
                { name: "CAM 02", top: "62%", left: "38%", w: "12%", h: "11%" },
