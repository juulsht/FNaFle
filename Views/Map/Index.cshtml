                { name: "Funtime Auditorium", top: "48%", left: "56%", w: "23%", h: "23%" },
                { name: "Breaker Room", top: "52%", left: "6%", w: "11%", h: "15%" },
                { name: "Parts & Service", top: "52%", left: "81%", w: "11%", h: "15%" }
            ]
        }
    };

    function loadMap(game){
    const data=mapData[game];
    if(!data)return;

    const wrapper=document.getElementById('mapWrapper');
    wrapper.style.display='block';
    document.getElementById('selectedGameTitle').innerText=game;

    const img=document.getElementById('layoutImage');
    img.classList.add("switching");
    setTimeout(()=>img.classList.remove("switching"),300);
    img.src=data.image;

    const overlay=document.getElementById('buttonOverlay');
    overlay.innerHTML='';

    img.onload=function(){
    data.buttons.forEach(btn=>{
    const el=document.createElement('div');
    el.className='map-click-zone';
    el.style.top=btn.top;
    el.style.left=btn.left;
    el.style.width=btn.w;
    el.style.height=btn.h;
    el.onclick=()=>submitGuess(game,btn.name);
    overlay.appendChild(el);
    });
    };
    if(img.complete)img.onload();

    wrapper.scrollIntoView({behavior:'smooth'});
    }

    function typeText(element,text,color){
    element.innerText="";
    element.style.color=color;
    let i=0;
    const interval=setInterval(()=>{
    element.innerText+=text[i];
    i++;
    if(i>=text.length)clearInterval(interval);
    },25);
    }

    function submitGuess(game,cam){
    fetch('/Map/CheckVisualGuess',{
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:new URLSearchParams({
    id:'@Model?.Id',
    gameName:game,
    cameraName:cam
    })
    })
    .then(res=>res.json())
    .then(data=>{
    if(data.success){
        const popup = document.getElementById('wrongGuessPopup');
        if (popup) {
            popup.innerText = '🎉 Correct! Come back tomorrow! :D';
            popup.style.color = '#4cff9a';
            popup.style.display = 'block';
        }
        document.querySelectorAll('.map-click-zone').forEach(btn => btn.style.pointerEvents = 'none');
    } else {
        const popup = document.getElementById('wrongGuessPopup');
        if (popup) {
            popup.style.display = 'block';
            setTimeout(() => popup.style.display = 'none', 3000);
        }
    }
    });
    }
</script>

<style>
    .border-red-container {
        position: relative;
        display: inline-block;
        border: 4px solid #1a1a1a;
        background: #000;
        line-height: 0;
    }

    #layoutImage {
        max-width: 600px;
        height: auto;
        display: block;
    }

    #buttonOverlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    /* CLICK ZONES */
    .map-click-zone {
        position: absolute;
        cursor: pointer;
        pointer-events: auto;
        background: rgba(255,0,0,0);
        border: 1px solid transparent;
        transition: .2s;
        z-index: 10;
    }

        .map-click-zone:hover {
            background: rgba(255,0,0,.25);
            border: 1px solid #f00;
            box-shadow: 0 0 15px #f00 inset,0 0 10px #f00;
            animation: pulse 1s infinite;
        }

    @@keyframes pulse {
        0% {
            opacity: 1
        }

        50% {
            opacity: .5
        }

        100% {
            opacity: 1
        }
    }

    /* CCTV FRAME */
    .cctv-frame {
        width: 100%;
        max-width: 700px;
        height: 400px;
        border: 15px solid #1a1a1a;
        border-radius: 10px;
        background: #050505;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 50px rgba(0,0,0,.8), inset 0 0 100px #000;
        animation: flicker 6s infinite;
    }

    .zoomed-map {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(2.8);
        transition: .4s;
    }

    .cam-overlay {
        position: absolute;
        top: 15px;
        left: 20px;
        color: #0f0;
        font-family: 'Courier New',monospace;
        text-shadow: 0 0 5px #0f0;
        z-index: 4;
    }

    /* TERMINAL TEXT */
    .terminal-label {
        color: #f00;
        letter-spacing: 2px;
        font-weight: bold;
        text-shadow: 0 0 8px #f00;
    }

    /* SCANLINE */
    .scanline {
        width: 100%;
        height: 100px;
        background: linear-gradient(0deg,transparent,rgba(255,255,255,.05),transparent);
        position: absolute;
        top: -100px;
        z-index: 3;
        animation: scan 4s linear infinite;
    }

    @@keyframes scan {
        0% {
            top: -100px
        }

        100% {
            top: 100%
        }
    }

    /* STATIC */
    .noise {
        position: absolute;
        inset: 0;
        background: url("https://grainy-gradients.vercel.app/noise.svg");
        opacity: .05;
        mix-blend-mode: overlay;
        pointer-events: none;
    }

    /* CRT FLICKER */
    @@keyframes flicker {
        0%, 18%, 22%, 25%, 53%, 57%, 100% {
            opacity: 1
        }

        20%, 24%, 55% {
            opacity: .4
        }
    }

    .auth-box {
        transition: .15s;
        cursor: pointer;
    }

        .auth-box:active {
            transform: scale(.92);
            filter: brightness(1.5);
        }

    .switching {
        animation: flash .3s;
    }

    @@keyframes flash {
        0% {
            filter: brightness(3)
        }

        100% {
            filter: brightness(1)
        }
    }
</style>

