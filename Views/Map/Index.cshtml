@model FNaFle.Models.MapLocation

@{
    ViewData["Title"] = "Signal Intercept";
}

<div class="background-blur"></div>

<div class="top-bar">
    <div class="left-buttons">
        <a asp-controller="Home" asp-action="Index" class="auth-box" style="text-decoration:none;">← Home</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="MapAdmin" asp-action="Index" class="auth-box" style="display:inline-block; margin-left:15px; text-decoration:none; background: rgba(0,255,0,0.1); border-color:#0f0; color:#0f0; box-shadow:0 0 8px #0f0;">+ MAP ADMIN</a>
        }
    </div>
</div>

<div class="game-container" style="padding-top: 100px;">

    <div class="logo-container" style="margin-bottom: 20px;">
        <h1 class="game-title">Camera Mode</h1>
        <p class="subtitle">Guess which camera you are on!</p>
    </div>

    @if (ViewBag.GuessedCorrectlyToday != null && (bool)ViewBag.GuessedCorrectlyToday)
    {
        if (ViewBag.JustWon != true)
        {
            <div class="text-center mb-4">
                <p class="success-msg">
                    You already guessed today's map — come back tomorrow!
                </p>
            </div>
        }
    }
    else
    {
        <div class="camera-filters-container mb-4">
            @if (ViewBag.AllGames != null)
            {
                foreach (var game in (List<string>)ViewBag.AllGames)
                {
                    <button class="auth-box map-btn" onclick="loadMap('@game')">@game</button>
                }
            }
        </div>
    }

    <div class="cctv-and-map-wrapper">
        
        <div class="cctv-frame-container">
            <div class="cctv-frame zoom-in-effect">
                <div class="scanline"></div>
                <div class="noise"></div>
                <div class="cam-overlay">REC &bull; CAMERA FEED</div>

                @if (Model != null)
                {
                    <img src="@Model.ImageUrl" class="zoomed-map" alt="Camera Feed" />
                }
                else
                {
                    <div class="no-feed">
                        <p class="text-danger mt-5" style="font-family: 'Courier New', monospace; font-size: 24px; text-shadow: 0 0 10px red;">NO SIGNAL DETECTED</p>
                    </div>
                }
            </div>
        </div>

        <div id="mapWrapper" style="display:none; text-align:center;">
            <h3 class="terminal-label mb-3 mt-3" id="selectedGameTitle"></h3>
            
            <div id="wrongGuessPopup" class="error-msg" style="display:none; margin-bottom: 15px; animation: fadeIn 0.3s ease;">(Wrong location, try again?)</div>
            <div id="correctGuessPopup" class="success-msg" style="display:none; margin-bottom: 15px; animation: fadeIn 0.3s ease;">Correct! Come back tomorrow! :D</div>

            <div class="border-red-container fade-in-effect">
                <img id="layoutImage" src="" alt="Map Layout">
                <div id="buttonOverlay"></div>
            </div>
        </div>
    </div>
</div>

<script>
    const mapData = {
        "FNaF 1": {
            image: "/images/maps/fnaf1.png",
            buttons: [
                { name: "CAM 1A", top: "2%", left: "32%", w: "14%", h: "12%" },
                { name: "CAM 1B", top: "17%", left: "27%", w: "14%", h: "12%" },
                { name: "CAM 1C", top: "39%", left: "19%", w: "14%", h: "12%" },
                { name: "CAM 5", top: "24%", left: "1%", w: "14%", h: "12%" },
                { name: "CAM 3", top: "67.5%", left: "11.5%", w: "14%", h: "12%" },
                { name: "CAM 7", top: "24.5%", left: "84%", w: "14%", h: "12%" },
                { name: "CAM 6", top: "62.5%", left: "81.5%", w: "14%", h: "12%" },
                { name: "CAM 2A", top: "72.5%", left: "32%", w: "14%", h: "12%" },
                { name: "CAM 2B", top: "84.5%", left: "32%", w: "14%", h: "12%" },
                { name: "CAM 4A", top: "72.5%", left: "58%", w: "14%", h: "12%" },
                { name: "CAM 4B", top: "84.5%", left: "58%", w: "14%", h: "12%" }
            ]
        },
        "FNaF 2": {
            image: "/images/maps/fnaf2.png",
            buttons: [
                { name: "CAM 08", top: "17%", left: "6.5%", w: "12%", h: "11%" },
                { name: "CAM 07", top: "21%", left: "43%", w: "12%", h: "11%" },
                { name: "CAM 09", top: "8%", left: "79%", w: "12%", h: "11%" },
                { name: "CAM 03", top: "41%", left: "6.5%", w: "12%", h: "11%" },
                { name: "CAM 04", top: "41%", left: "38%", w: "12%", h: "11%" },
                { name: "CAM 11", top: "32%", left: "87%", w: "12%", h: "11%" },
                { name: "CAM 01", top: "62%", left: "6.5%", w: "12%", h: "11%" },
                { name: "CAM 02", top: "62%", left: "38%", w: "12%", h: "11%" },
                { name: "CAM 10", top: "46%", left: "63%", w: "12%", h: "11%" },
                { name: "CAM 05", top: "89%", left: "8%", w: "12%", h: "11%" },
                { name: "CAM 06", top: "89%", left: "35%", w: "12%", h: "11%" },
                { name: "CAM 12", top: "62%", left: "83%", w: "12%", h: "11%" }
            ]
        },
        "FNaF 3": {
            image: "/images/maps/fnaf3.png",
            buttons: [
                { name: "CAM 07", top: "23%", left: "15%", w: "12%", h: "11%" },
                { name: "CAM 08", top: "17%", left: "36%", w: "12%", h: "11%" },
                { name: "CAM 09", top: "5%", left: "49%", w: "12%", h: "11%" },
                { name: "CAM 10", top: "15%", left: "70%", w: "12%", h: "11%" },
                { name: "CAM 06", top: "43%", left: "15%", w: "12%", h: "11%" },
                { name: "CAM 05", top: "43%", left: "42%", w: "12%", h: "11%" },
                { name: "CAM 04", top: "38%", left: "74%", w: "12%", h: "11%" },
                { name: "CAM 03", top: "58%", left: "71%", w: "12%", h: "11%" },
                { name: "CAM 02", top: "72%", left: "58%", w: "12%", h: "11%" },
                { name: "CAM 01", top: "82%", left: "16%", w: "12%", h: "11%" }
            ]
        },
        "FFPS": {
            image: "/images/maps/fnaf6.png",
            buttons: [
                { name: "Room 1", top: "23%", left: "25%", w: "8%", h: "8%" },
                { name: "Room 2", top: "23%", left: "40%", w: "8%", h: "8%" },
                { name: "Room 3", top: "45%", left: "25%", w: "8%", h: "8%" },
                { name: "Room 4", top: "45%", left: "40%", w: "8%", h: "8%" },
                { name: "Room 5", top: "23%", left: "60%", w: "8%", h: "8%" },
                { name: "Room 6", top: "23%", left: "75%", w: "8%", h: "8%" },
                { name: "Room 7", top: "45%", left: "60%", w: "8%", h: "8%" },
                { name: "Room 8", top: "45%", left: "75%", w: "8%", h: "8%" }
            ]
        },
        "FNaF SL": {
            image: "/images/maps/fnafsl.png",
            buttons: [
                { name: "Elevator", top: "82%", left: "45%", w: "10%", h: "13%" },
                { name: "Control Module", top: "48%", left: "43%", w: "14%", h: "20%" },
                { name: "Circus Control", top: "24%", left: "44.5%", w: "11%", h: "12%" },
                { name: "Circus Gallery", top: "7%", left: "38%", w: "24%", h: "16%" },
                { name: "Ballora Gallery", top: "48%", left: "19%", w: "23%", h: "23%" },
                { name: "Funtime Auditorium", top: "48%", left: "56%", w: "23%", h: "23%" },
                { name: "Breaker Room", top: "52%", left: "6%", w: "11%", h: "15%" },
                { name: "Parts & Service", top: "52%", left: "81%", w: "11%", h: "15%" }
            ]
        }
    };

    function loadMap(game){
        const data = mapData[game];
        if(!data) return;

        const wrapper = document.getElementById('mapWrapper');
        wrapper.style.display = 'block';
        document.getElementById('selectedGameTitle').innerText = game;

        const img = document.getElementById('layoutImage');
        img.classList.add("switching");
        setTimeout(() => img.classList.remove("switching"), 300);
        img.src = data.image;

        const overlay = document.getElementById('buttonOverlay');
        overlay.innerHTML = '';

        img.onload = function() {
            data.buttons.forEach(btn => {
                const el = document.createElement('div');
                el.className = 'map-click-zone';
                el.style.top = btn.top;
                el.style.left = btn.left;
                el.style.width = btn.w;
                el.style.height = btn.h;
                el.onclick = () => submitGuess(game, btn.name);
                overlay.appendChild(el);
            });
        };
        if(img.complete) img.onload();

        wrapper.scrollIntoView({behavior: 'smooth', block: 'start'});
    }

    function submitGuess(game, cam){
        fetch('/Map/CheckVisualGuess',{
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: new URLSearchParams({
                id: '@Model?.Id',
                gameName: game,
                cameraName: cam
            })
        })
        .then(res => res.json())
        .then(data => {
            document.getElementById('wrongGuessPopup').style.display = 'none';
            document.getElementById('correctGuessPopup').style.display = 'none';

            if(data.success){
                const correctPopup = document.getElementById('correctGuessPopup');
                correctPopup.style.display = 'block';
                document.querySelectorAll('.map-click-zone').forEach(btn => btn.style.pointerEvents = 'none');
                
                // Keep the text green immediately and permanently
                // Also scroll view to the map slightly
                setTimeout(() => window.scrollBy({ top: -100, behavior: 'smooth' }), 100);
            } else {
                const wrongPopup = document.getElementById('wrongGuessPopup');
                wrongPopup.style.display = 'block';
                wrongPopup.style.animation = 'fadeIn 0.3s ease';
                setTimeout(() => {
                    wrongPopup.style.animation = 'fadeOut 0.3s ease forwards';
                    setTimeout(() => {
                        wrongPopup.style.display = 'none';
                        wrongPopup.style.animation = ''; // reset
                    }, 280);
                }, 3000);
            }
        });
    }
</script>

<style>
    /* MAIN CONTAINER CHANGES */
    .game-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        background-color: rgba(0, 0, 0, 0.65);
        padding-bottom: 50px;
    }

    .camera-filters-container {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        width: 100%;
        max-width: 800px;
        margin-bottom: 30px;
    }

    .map-btn {
        min-width: 120px;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
    }



    /* ALIGNMENT OF CCTV AND MAPS */
    .cctv-and-map-wrapper {
        display: flex;
        flex-direction: column;
        gap: 40px;
        align-items: center;
        width: 100%;
        max-width: 1000px;
    }

    .cctv-frame-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .cctv-frame {
        width: 100%;
        max-width: 650px;
        aspect-ratio: 16/9;
        height: auto;
        border: 12px solid #1a1a1a;
        border-radius: 12px;
        background: #050505;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.9), inset 0 0 80px #000;
        animation: flicker 6s infinite;
    }

    .zoomed-map {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(2.2);
        transition: transform 0.8s ease-out;
    }

    .zoomed-map:hover {
        transform: scale(2.0);
    }

    .cam-overlay {
        position: absolute;
        top: 15px;
        left: 20px;
        color: #0f0;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        text-shadow: 0 0 8px #0f0;
        z-index: 4;
        font-size: 14px;
        animation: blink 2s infinite;
    }

    @@keyframes blink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
    }

    /* RED BORDER CONTAINER REWORK */
    .border-red-container {
        position: relative;
        display: inline-block;
        border-radius: 12px;
        background: #000;
        box-shadow: 0 8px 30px rgba(0,0,0,0.8), 0 0 15px rgba(255, 0, 0, 0.4);
        padding: 10px;
        border: 2px solid #330000;
        transition: all 0.3s ease;
    }

    .border-red-container:hover {
        border-color: #ff0000;
        box-shadow: 0 8px 30px rgba(0,0,0,0.8), 0 0 25px rgba(255, 0, 0, 0.6);
    }

    #layoutImage {
        max-width: 650px;
        width: 100%;
        height: auto;
        display: block;
        border-radius: 6px;
    }

    #buttonOverlay {
        position: absolute;
        top: 10px;
        left: 10px;
        width: calc(100% - 20px);
        height: calc(100% - 20px);
        pointer-events: none;
    }

    /* CLICK ZONES */
    .map-click-zone {
        position: absolute;
        cursor: pointer;
        pointer-events: auto;
        background: rgba(255,0,0,0);
        border: 1px solid transparent;
        border-radius: 4px;
        transition: .2s;
        z-index: 10;
    }

    .map-click-zone:hover {
        background: rgba(255,0,0,.25);
        border: 1px solid #f00;
        box-shadow: 0 0 15px #f00 inset, 0 0 10px #f00;
        animation: pulse 1s infinite;
    }

    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: .5; }
        100% { opacity: 1; }
    }

    /* FAST EFFECTS */
    .fade-in-effect {
        animation: fadeIn 0.4s ease-out;
    }

    .zoom-in-effect {
        animation: zoomIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes fadeOut {
        from { opacity: 1; transform: translateY(0); }
        to { opacity: 0; transform: translateY(15px); }
    }

    @@keyframes zoomIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    /* TERMINAL TEXT */
    .terminal-label {
        color: #f00;
        letter-spacing: 2px;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
        text-shadow: 0 0 10px #f00;
        font-size: 1.8rem;
    }

    /* SCANLINE */
    .scanline {
        width: 100%;
        height: 100%;
        background: linear-gradient(0deg, transparent, rgba(255,255,255,0.08) 50%, transparent);
        position: absolute;
        top: -100%;
        z-index: 3;
        animation: scan 5s linear infinite;
        pointer-events: none;
    }

    @@keyframes scan {
        0% { top: -100%; }
        100% { top: 100%; }
    }

    /* STATIC */
    .noise {
        position: absolute;
        inset: 0;
        background: url("https://grainy-gradients.vercel.app/noise.svg");
        opacity: .12;
        mix-blend-mode: overlay;
        pointer-events: none;
        z-index: 2;
    }

    /* CRT FLICKER */
    @@keyframes flicker {
        0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
        20%, 24%, 55% { opacity: .7; }
    }

    /* BUTTONS */
    .auth-box {
        transition: .15s;
        cursor: pointer;
    }

    .auth-box:active {
        transform: scale(.92);
        filter: brightness(1.2);
    }

    .switching {
        animation: flash .3s;
    }

    @@keyframes flash {
        0% { filter: brightness(2) contrast(1.5); }
        100% { filter: brightness(1) contrast(1); }
    }
</style>
