@model FNaFle.Models.Character
@{
    ViewData["Title"] = Model.Name;
}

<div class="details-page">

    <!-- Back Button -->
    <a asp-action="Index" class="auth-box details-back">← Back</a>

    <div class="details-card">

        <!-- IMAGE -->
        <div class="details-image-box">
            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="details-image" />
            }
            else
            {
                <div class="details-image placeholder">No Image</div>
            }
        </div>

        <!-- NAME -->
        <h1 class="details-title">@Model.Name</h1>

        <!-- STATS PANEL -->
        <div class="details-stats">

            <div class="details-row">
                <span class="details-label">Gender</span>
                <span class="details-value">@Model.Gender</span>
            </div>

            <div class="details-row">
                <span class="details-label">Generation</span>
                <span class="details-value">@Model.Generation</span>
            </div>

            <div class="details-row">
                <span class="details-label">Species</span>
                <span class="details-value">@Model.Species</span>
            </div>

            <div class="details-row">
                <span class="details-label">Location</span>
                <span class="details-value">@Model.Location</span>
            </div>

            <div class="details-row">
                <span class="details-label">Status</span>
                <span class="details-value">@Model.Status</span>
            </div>

        </div>

        <!-- Admin Buttons -->
        @if (User.IsInRole("Admin"))
        {
            <div class="details-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="auth-box">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="auth-box delete-admin">Delete</a>
            </div>

            <!-- Voice Lines Panel -->
            <div style="margin-top: 30px; text-align: left; background: rgba(0,0,0,0.5); padding: 15px; border-radius: 8px; border: 1px solid #ff000040;">
                <h3 style="color: #ff7a7a; margin-bottom: 10px;">Voice Lines</h3>
                
                @if (Model.VoiceLines != null && Model.VoiceLines.Any())
                {
                    <ul style="list-style: none; padding: 0;">
                        @foreach (var vl in Model.VoiceLines)
                        {
                            <li style="margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 5px;">
                                <span>"@vl.Text"</span>
                                <form asp-action="DeleteVoiceLine" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@vl.Id" />
                                    <button type="submit" class="auth-box delete-admin" style="padding: 4px 8px; font-size: 12px; margin-left: 10px;">Delete</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p style="color: #888; font-size: 14px;">No voice lines added yet.</p>
                }

                <form asp-action="AddVoiceLine" method="post" style="margin-top: 15px; display: flex; gap: 10px;">
                    <input type="hidden" name="characterId" value="@Model.Id" />
                    <input type="text" name="text" placeholder="Enter new voice line..." required
                           style="flex-grow: 1; padding: 8px; border-radius: 6px; border: 1px solid #444; background: #111; color: white;" />
                    <button type="submit" class="auth-box" style="padding: 8px 15px;">Add</button>
                </form>
            </div>
        }

    </div>

</div>

<style>

    /* PAGE WRAPPER */
    .details-page {
        padding-top: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-bottom: 80px;
    }

    /* BACK BUTTON */
    .details-back {
        margin-bottom: 25px;
    }

    /* MAIN DETAILS CARD */
    .details-card {
        width: min(750px, 92vw);
        background: rgba(0,0,0,0.65);
        border: 2px solid rgba(255,0,0,0.4);
        padding: 35px;
        border-radius: 16px;
        color: white;
        text-align: center;
        box-shadow: 0 0 22px rgba(255,0,0,0.3);
    }

    /* IMAGE */
    .details-image-box {
        width: fit-content;
        max-width: 100%;
        margin: 0 auto 25px auto;
        border-radius: 12px;
        border: 1px solid rgba(255, 0, 0, 0.3);
        box-shadow: 0 0 16px rgba(255, 0, 0, 0.25);
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(10, 0, 0, 0.4);
        overflow: hidden;
    }

    .details-image {
        max-width: 100%;
        max-height: 550px;
        display: block;
        object-fit: contain;
    }

        .details-image.placeholder {
            height: 300px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(20,0,0,0.5);
            color: #888;
        }

    /* NAME */
    .details-title {
        font-size: 40px;
        color: #ff0000;
        text-shadow: 0 0 14px #ff0000, 0 0 26px #ff0000;
        margin-bottom: 25px;
        letter-spacing: 1px;
    }

    /* STAT PANEL */
    .details-stats {
        margin-top: 10px;
        margin-bottom: 35px;
    }

    /* Each row */
    .details-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 20px;
        border-radius: 10px;
        margin-bottom: 10px;
        background: rgba(20, 0, 0, 0.45);
        border: 1px solid rgba(255,0,0,0.3);
        box-shadow: inset 0 0 8px rgba(255, 0, 0, 0.15);
    }

    /* Label = left side text */
    .details-label {
        font-weight: bold;
        color: #ff7a7a;
    }

    /* Value = right side */
    .details-value {
        font-weight: bold;
        color: white;
        opacity: 0.9;
    }

    /* ADMIN BUTTONS */
    .details-actions {
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    /* Special delete styling */
    .delete-admin {
        background: rgba(80, 0, 0, 0.8);
        border-color: rgba(255,0,0,0.7) !important;
        box-shadow: 0 0 18px rgba(255, 0, 0, 0.5);
    }

        .delete-admin:hover {
            background: rgba(130, 0, 0, 0.9);
            box-shadow: 0 0 28px #ff0000;
        }

</style>
